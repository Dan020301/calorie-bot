# Скопируй этот файл в .env и подставь свои значения

# Токен бота от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=8361326681:AAECCvehhaxx6rJ3WnL9sa-zRb67tpAwoi4

# API-ключ Google Gemini (бесплатно на https://aistudio.google.com/apikey)
GEMINI_API_KEY=AQ.Ab8RN6Jan26Mow0w97pX3JUMq43uHPbsZVmbDg9V1sxrI10lXg

# Путь к файлу базы данных SQLite
DATABASE_PATH=calories.db

# Часовой пояс для напоминаний и подсчёта суток
TIMEZONE=Europe/Moscow

# Время напоминаний о подсчёте калорий (через запятую)
REMINDER_TIMES=09:00,13:00,18:00,21:00

# Модель Gemini для распознавания фото
# gemini-3.5-flash-lite — стабильная и быстрая, щедрый бесплатный лимит
VISION_MODEL=gemini-3.5-flash-lite

# Норма воды в день, мл
WATER_NORM_ML=2000

# Время ежедневного отчёта «итоги дня» (HH:MM)
DAILY_SUMMARY_TIME=21:30

# Время еженедельной сводки (воскресенье, HH:MM)
WEEKLY_SUMMARY_TIME=20:00

